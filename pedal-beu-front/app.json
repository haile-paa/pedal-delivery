{
  "expo": {
    "name": "Pedal Delivery",
    "slug": "pedal-beu-front",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pedalbeufront",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pedaldelivery.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Pedal Delivery uses your location to show nearby restaurants, track deliveries, and help drivers navigate to pickup and drop-off points.",
        "NSCameraUsageDescription": "Pedal Delivery needs camera access so you can take photos for your profile, documents, or delivery proof.",
        "NSPhotoLibraryUsageDescription": "Pedal Delivery needs photo library access so you can upload photos for your profile or documents."
      }
    },
    "android": {
      "package": "com.pedaldelivery.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FDF6E6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pedal Delivery uses your location to show nearby restaurants, track deliveries, and help drivers navigate."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pedal Delivery needs photo library access so you can upload photos for your profile or documents.",
          "cameraPermission": "Pedal Delivery needs camera access so you can take photos for your profile or documents."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9fe916ca-38ee-4725-b0bd-8b0fbd3faf78"
      }
    }
  }
}
